# Copy → /home/sysadmin/npd-ecosystem/.env và chỉnh URL/STK

BANK_URL=https://npd-banking.co
SHOP_URL=https://npd-shop.co
VERIFY_TLS=0
ADMIN_SECRET=banking-admin-2025

# Users
DEFAULT_PASSWORD=123456
USER_BALANCE=10000000
LY_BALANCE=50000000
LY_PHONE=0901234567
LY_USERNAME="Nguyễn Hương Ly"
# Điền sau seed / từ demo-huongly.json
LY_ACCOUNT_NUMBER=

TARGET_CUSTOMERS=2000
TARGET_SUPPLIERS=200
SEED_BATCH=200

# Peer transfers (mỗi 10 phút)
TRANSFER_MIN=50000
TRANSFER_MAX=500000
TRANSFER_ROUNDS=80
TRANSFER_WORKERS=20

# Shop buy (mỗi 3 giờ)
SHOP_BUY_COUNT=40
SHOP_BUY_WORKERS=8

# Ly nhập hàng (12h & 18h) — giá nhập = 70% catalog
RESTOCK_COST_RATIO=0.70
RESTOCK_ITEMS=30

DATA_DIR=/home/sysadmin/npd-ecosystem/data
LOG_DIR=/home/sysadmin/npd-ecosystem/logs
